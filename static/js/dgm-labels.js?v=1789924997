/* Shared density-aware label placement for the "Cases by State" map (flat + 3D views).
   Pure geometry: callers project their own ring/anchor points into screen-pixel space (2D:
   Leaflet container pixels; 3D: perspective-projected canvas pixels) and this module decides,
   per state, whether a label fits at all, what it says, how big it renders, and which labels
   lose out to a higher-count neighbour when boxes collide. */
(function () {
  "use strict";

  function shoelaceArea(ring) {
    var a = 0;
    for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      a += ring[j][0] * ring[i][1] - ring[i][0] * ring[j][1];
    }
    return Math.abs(a / 2);
  }

  // Multipolygon states (islands, detached keys, panhandles split from the mainland ring) get
  // labelled on their single largest ring only - a label centred across the whole multipolygon's
  // bbox is what put "ME 6" and "FL 14" out in the ocean in the previous version of this map.
  function largestRing(geometry) {
    var polys = geometry.type === "MultiPolygon" ? geometry.coordinates : [geometry.coordinates];
    var best = null, bestArea = -1;
    polys.forEach(function (poly) {
      var ring = poly[0];
      var a = shoelaceArea(ring);
      if (a > bestArea) { bestArea = a; best = ring; }
    });
    return best;
  }

  // Coastlines carry far more vertices than a distance-field search needs - Alaska's mainland ring
  // alone runs ~4000 points. Capping it keeps poleOfInaccessibility() fast; the rendered geometry
  // elsewhere (the actual choropleth/extrusion) is untouched by this.
  function downsample(ring, maxPoints) {
    if (ring.length <= maxPoints) return ring;
    var out = [];
    var step = ring.length / maxPoints;
    for (var i = 0; i < maxPoints; i++) out.push(ring[Math.floor(i * step)]);
    return out;
  }

  // Pole of inaccessibility (Mapbox's polylabel algorithm): the point inside the polygon farthest
  // from any edge. Doubles as the label anchor (guaranteed deep inside the shape, not just its bbox
  // centre) and as the fit radius `d` - a label whose half-diagonal is <= d is mathematically
  // guaranteed to stay inside the polygon, which is what rule out labels spilling into the ocean.
  function segDist2(px, py, a, b) {
    var x = a[0], y = a[1], dx = b[0] - x, dy = b[1] - y;
    if (dx !== 0 || dy !== 0) {
      var t = ((px - x) * dx + (py - y) * dy) / (dx * dx + dy * dy);
      if (t > 1) { x = b[0]; y = b[1]; } else if (t > 0) { x += dx * t; y += dy * t; }
    }
    dx = px - x; dy = py - y;
    return dx * dx + dy * dy;
  }

  // Standard ray-casting point-in-polygon test. Exported (see pointInRing below) so callers/tests
  // can independently verify "does this label's anchor actually sit inside the state it labels" -
  // the same question pointToPolyDist answers via its sign, exposed directly as a boolean.
  function rayCastInside(x, y, ring) {
    var inside = false;
    for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      var a = ring[i], b = ring[j];
      if ((a[1] > y) !== (b[1] > y) &&
          x < (b[0] - a[0]) * (y - a[1]) / (b[1] - a[1]) + a[0]) inside = !inside;
    }
    return inside;
  }

  function pointToPolyDist(x, y, ring) {
    var minD2 = Infinity;
    for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      minD2 = Math.min(minD2, segDist2(x, y, ring[i], ring[j]));
    }
    return (rayCastInside(x, y, ring) ? 1 : -1) * Math.sqrt(minD2);
  }

  function cell(x, y, h, ring) {
    var d = pointToPolyDist(x, y, ring);
    return { x: x, y: y, h: h, d: d, max: d + h * Math.SQRT2 };
  }

  function centroidCell(ring) {
    var area = 0, x = 0, y = 0;
    for (var i = 0, j = ring.length - 1; i < ring.length; j = i++) {
      var a = ring[i], b = ring[j];
      var f = a[0] * b[1] - b[0] * a[1];
      x += (a[0] + b[0]) * f; y += (a[1] + b[1]) * f; area += f * 3;
    }
    return area === 0 ? cell(ring[0][0], ring[0][1], 0, ring) : cell(x / area, y / area, 0, ring);
  }

  function poleOfInaccessibility(ring, precision) {
    precision = precision || 1;
    ring = downsample(ring, 400);
    var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    ring.forEach(function (p) {
      if (p[0] < minX) minX = p[0]; if (p[0] > maxX) maxX = p[0];
      if (p[1] < minY) minY = p[1]; if (p[1] > maxY) maxY = p[1];
    });
    var width = maxX - minX, height = maxY - minY;
    var size = Math.min(width, height);
    if (size <= 0) return { x: (minX + maxX) / 2, y: (minY + maxY) / 2, d: 0 };
    var h = size / 2;
    var queue = [];
    for (var x = minX; x < maxX; x += size) {
      for (var y = minY; y < maxY; y += size) queue.push(cell(x + h, y + h, h, ring));
    }
    var best = centroidCell(ring);
    var bboxC = cell(minX + width / 2, minY + height / 2, 0, ring);
    if (bboxC.d > best.d) best = bboxC;
    var guard = 0;
    while (queue.length && guard++ < 2000) {
      queue.sort(function (a, b) { return b.max - a.max; });
      var c = queue.shift();
      if (c.d > best.d) best = c;
      if (c.max - best.d <= precision) continue;
      var half = c.h / 2;
      queue.push(cell(c.x - half, c.y - half, half, ring));
      queue.push(cell(c.x + half, c.y - half, half, ring));
      queue.push(cell(c.x - half, c.y + half, half, ring));
      queue.push(cell(c.x + half, c.y + half, half, ring));
    }
    return { x: best.x, y: best.y, d: best.d };
  }

  // One offscreen canvas measures every label in both views, so grading uses real font metrics
  // instead of a per-character width guess.
  var mctx = document.createElement("canvas").getContext("2d");
  function measureTextPx(text, fontPx) {
    mctx.font = "700 " + fontPx + "px 'IBM Plex Sans', system-ui, sans-serif";
    return { w: mctx.measureText(text).width, h: fontPx * 0.92 };
  }

  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  // Thresholds (screen px, or the equivalent unit the caller projects into):
  //  - minDFull (24px radius): a "full" label ("TX 24") is a zoom-driven upgrade, not something
  //    every state competes for at the national view - at national zoom essentially nothing has a
  //    24px inscribed radius, so every state renders its bare abbreviation ("TX") until the reader
  //    zooms in on it. This is deliberate: with ~50 states on a 390px phone there is no room for
  //    inline counts, and putting them inline anyway is what produced the leader-line callout mess
  //    this file replaced. The exact count always lives in the ranked table below the map.
  //  - minDAbbr (8px radius): below this, no label of any kind - a footprint too small to hold
  //    even 2 characters at an 8px floor legibly.
  //  - fontKFull/fontKAbbr: seed font size = d * k, then verified against real measured text via
  //    the half-diagonal-fits-inside-the-inscribed-circle test (safety-margined by `safety`).
  var DEFAULTS = {
    fontMin: 8, fontMax: 20,
    fontKFull: 0.58, fontKAbbr: 1.0,
    minDFull: 24, minDAbbr: 8,
    safety: 0.88, padding: 4
  };

  // The core density-aware grading + collision pass, shared by the flat and 3D views. Candidates
  // are already in the caller's own screen-pixel space: {code, count, x, y, d}, where d is the
  // pole-of-inaccessibility radius in that same pixel space.
  function placeLabels(candidates, opts) {
    opts = opts || {};
    var cfg = {};
    Object.keys(DEFAULTS).forEach(function (k) { cfg[k] = opts[k] != null ? opts[k] : DEFAULTS[k]; });
    var measure = opts.measure || measureTextPx;
    var fullTemplate = opts.fullTemplate || function (code, count) { return count ? code + " " + count : code; };
    var abbrTemplate = opts.abbrTemplate || function (code) { return code; };

    function fits(d, text, fontPx) {
      var m = measure(text, fontPx);
      var halfDiag = Math.sqrt((m.w / 2) * (m.w / 2) + (m.h / 2) * (m.h / 2));
      return halfDiag <= d * cfg.safety;
    }

    var results = {};
    candidates.forEach(function (c) {
      var out = { code: c.code, grade: "none", text: null, fontPx: null, w: 0, h: 0 };
      var fullText = fullTemplate(c.code, c.count);
      var abbrText = abbrTemplate(c.code);
      var fFull = clamp(c.d * cfg.fontKFull, cfg.fontMin, cfg.fontMax);
      var fAbbr = clamp(c.d * cfg.fontKAbbr, cfg.fontMin, cfg.fontMax);
      if (c.d >= cfg.minDFull && fits(c.d, fullText, fFull)) {
        out.grade = "full"; out.text = fullText; out.fontPx = fFull;
      } else if (c.d >= cfg.minDAbbr && fits(c.d, abbrText, fAbbr)) {
        out.grade = "abbr"; out.text = abbrText; out.fontPx = fAbbr;
      }
      if (out.grade !== "none") {
        var m = measure(out.text, out.fontPx);
        out.w = m.w + cfg.padding; out.h = m.h + cfg.padding;
      }
      results[c.code] = out;
    });

    // Collision pass: highest case count wins the space; a loser is demoted from full -> abbr
    // before being dropped outright, so a mid-size state keeps its abbreviation as long as it fits.
    var order = candidates.filter(function (c) { return results[c.code].grade !== "none"; })
      .sort(function (a, b) { return (b.count - a.count) || (b.d - a.d); });

    var accepted = [];
    function overlaps(box) {
      return accepted.some(function (o) {
        return Math.abs(box.x - o.x) * 2 < (box.w + o.w) && Math.abs(box.y - o.y) * 2 < (box.h + o.h);
      });
    }

    order.forEach(function (c) {
      var r = results[c.code];
      var box = { x: c.x, y: c.y, w: r.w, h: r.h };
      if (!overlaps(box)) { accepted.push(box); return; }
      if (r.grade === "full" && c.d >= cfg.minDAbbr) {
        var abbrText = abbrTemplate(c.code);
        var fAbbr = clamp(c.d * cfg.fontKAbbr, cfg.fontMin, cfg.fontMax);
        if (fits(c.d, abbrText, fAbbr)) {
          var m = measure(abbrText, fAbbr);
          var box2 = { x: c.x, y: c.y, w: m.w + cfg.padding, h: m.h + cfg.padding };
          if (!overlaps(box2)) {
            results[c.code] = { code: c.code, grade: "abbr", text: abbrText, fontPx: fAbbr, w: box2.w, h: box2.h };
            accepted.push(box2);
            return;
          }
        }
      }
      results[c.code] = { code: c.code, grade: "none", text: null, fontPx: null, w: 0, h: 0 };
    });

    return results;
  }

  window.DGMLabels = {
    shoelaceArea: shoelaceArea,
    largestRing: largestRing,
    downsample: downsample,
    poleOfInaccessibility: poleOfInaccessibility,
    pointInRing: rayCastInside,
    measureTextPx: measureTextPx,
    placeLabels: placeLabels,
    defaults: DEFAULTS
  };
})();
